{
  "expo": {
    "name": "Swipeit",
    "slug": "memeswipe",
    "scheme": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.memeswipe.mobile",
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "package": "com.memeswipe.mobile",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "extra": {
      "apiBase": "https://memeswipe.onrender.com",
      "privyAppId": "cmm22gaas01qw0djot7jeb7g4",
      "privyClientId": "client-WY6WhsZXya69tFYhdGTNGtcMDKTR6G2CoMkRSMMvbDKD2"
    }
  }
}
